# Local development only. These defaults must not be used for a deployment.
POSTGRES_PASSWORD=mantik-local-development
POSTGRES_PORT=45432
MANTIK_PORT=40880
MANTIK_API_TOKEN=mantik-local-development
# Independent timer polling; accepted range is 100ms through 1m.
MANTIK_TIMER_INTERVAL=1s
# For native service execution against the Compose database:
DATABASE_URL=postgres://mantik:mantik-local-development@127.0.0.1:45432/mantik?sslmode=disable
